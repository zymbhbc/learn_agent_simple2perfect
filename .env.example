# Template for project-local secrets. Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored; .env.example is safe to commit.

# DeepSeek API (OpenAI-compatible endpoint).
DEEPSEEK_API_KEY=sk-REPLACE_WITH_NEW_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro